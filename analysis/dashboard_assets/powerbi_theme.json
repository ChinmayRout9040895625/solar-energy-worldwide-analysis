{
  "name": "Solar Editorial",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#104281",
  "center": "#86b6ef",
  "minimum": "#cde2fb",
  "background": "#FCFCFB",
  "secondaryBackground": "#F1F0EC",
  "foreground": "#0B0B0B",
  "tableAccent": "#2a78d6",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 15,
      "color": "#0B0B0B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#52514E"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#52514E"
    },
    "callout": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 38,
      "color": "#0B0B0B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E0D9" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": false }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0B0B0B" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#52514E" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": { "solid": { "color": "#52514E" } },
            "fontSize": 9,
            "lineColor": { "solid": { "color": "#C3C2B7" } }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#EFEEE9" } },
            "gridlineThickness": 1,
            "gridlineStyle": "solid",
            "labelColor": { "solid": { "color": "#898781" } },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#52514E" } },
            "fontSize": 9
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0B0B0B" } },
            "fontSize": 32,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#898781" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E0D9" } }, "radius": 8 }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#2a78d6" } } }],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#52514E" } },
            "fontSize": 9
          }
        ],
        "valueAxis": [{ "showAxisTitle": false, "gridlineShow": true }]
      }
    },
    "scatterChart": {
      "*": {
        "dataPoint": [{ "fill": { "solid": { "color": "#2a78d6" } } }],
        "bubbles": [{ "bubbleSize": -20 }],
        "categoryAxis": [{ "showAxisTitle": true }],
        "valueAxis": [{ "showAxisTitle": true }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E0D9" } }, "radius": 8 }],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#898781" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "background": { "solid": { "color": "#FFFFFF" } },
            "outline": "None"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#0B0B0B" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#EFEEE9" } },
            "rowPadding": 4,
            "outlineColor": { "solid": { "color": "#E1E0D9" } },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#52514E" } },
            "backColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#0B0B0B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#0B0B0B" } },
            "backColorSecondary": { "solid": { "color": "#FAFAF8" } },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#F4F3EF" } }, "transparency": 0 }
        ],
        "outspace": [
          { "color": { "solid": { "color": "#F4F3EF" } }, "transparency": 0 }
        ]
      }
    }
  }
}
